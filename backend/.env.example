# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-health-northeast

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Fraud Engine Thresholds
FRAUD_DUPLICATE_WINDOW_MINUTES=30
FRAUD_MAX_REPORTS_PER_HOUR=5
FRAUD_CONFIDENCE_THRESHOLD=0.6
OUTBREAK_MIN_CLUSTER_SIZE=5
OUTBREAK_TIME_WINDOW_HOURS=48

# FastAPI ML Service URL (use 127.0.0.1 on Windows to avoid IPv6 ::1 resolution issues)
ML_SERVICE_URL=http://127.0.0.1:8000

# Twilio Verify SMS OTP Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
